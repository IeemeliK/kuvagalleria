package components

import "github.com/IeemeliK/kuvagalleria/internal/middleware"

templ Header() {
	<header class="navbar bg-base-100 shadow-sm">
		<div class="flex-1">
			<a class="btn btn-ghost text-xl" href="/" hx-boost="true">Kuvagalleria</a>
		</div>
		if name, ok := middleware.UsernameFromContext(ctx); ok {
			<div>
				<span class="text-sm">{ name }</span>
				<button class="btn btn-soft btn-error mx-2.5" hx-post="/logout">
					Kirjaudu ulos
				</button>
			</div>
		}
	</header>
}
